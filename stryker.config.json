{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "plugins": [
    "@stryker-mutator/vitest-runner",
    "@stryker-mutator/typescript-checker"
  ],
  "disableTypeChecks": "src/**/*.{ts,tsx}",
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/lib/session.ts",
    "src/lib/m1-auth.ts",
    "src/lib/bff-route.ts",
    "src/lib/bff-backend.ts",
    "src/lib/input-limits.ts",
    "src/lib/argentina-date.ts",
    "src/lib/m6-roles.ts",
    "src/lib/crew-fit.ts",
    "src/lib/display-ids.ts",
    "src/lib/error-message.ts",
    "src/lib/referral-anomalies.ts",
    "src/lib/sanction-outcomes.ts",
    "src/lib/map-coverage.ts",
    "src/lib/authenticated-fetch.ts",
    "src/lib/me.ts",
    "src/lib/tolerant-records.ts",
    "src/lib/backend-shape.ts",
    "src/lib/bff-response-path.ts",
    "src/app/api/audit/route.ts",
    "src/app/api/me/**/route.ts",
    "src/app/api/health/route.ts",
    "src/app/api/role-assignments/**/route.ts",
    "!src/app/api/**/*.test.ts",
    "src/app/api/session/route.ts",
    "src/app/api/session/logout/route.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "reporters": [
    "html",
    "clear-text",
    "json",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "ignorePatterns": [
    "/.claude*",
    "/.agents*",
    "/.codex*",
    "/.orca",
    "/.next*",
    "/.playwright-cli",
    "/e2e",
    "/coverage*",
    "/playwright-report",
    "/test-results",
    "/reports",
    "/docs"
  ],
  "concurrency": 4,
  "dryRunTimeoutMinutes": 15,
  "timeoutMS": 10000,
  "incremental": true,
  "incrementalFile": "reports/mutation/incremental.json"
}