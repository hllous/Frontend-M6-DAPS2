# ─── Autenticación del BFF ──────────────────────────────
# mock    → fixtures locales (desarrollo y pruebas; nunca en producción).
# real-m1 → autenticación M1 del lado del servidor (único modo desplegable).
M6_AUTH_MODE=mock

# ─── Backend M6 ─────────────────────────────────────────
# Origen privado del backend; necesario para usar real-m1 contra un backend real.
# Para M1 falso + Backend MSW local, seguí docs/agents/real-m1-development.md.
M6_BACKEND_ORIGIN=http://localhost:3000

# ─── M1 real o falso local ──────────────────────────────
# Base de M1. Para el M1 desplegado: https://ciudadanos-m1-backend.onrender.com/
# Para el M1 falso local: http://127.0.0.1:3120/api/v1/
# En producción debe ser HTTPS y apuntar al M1 real. Nunca habilitar el servidor falso.
# M1_BASE_URL=https://ciudadanos-m1-backend.onrender.com/
# M1_FAKE_ENABLED=true
# M1_FAKE_JWT_SECRET=  # Base64 opcional para el servidor falso; usa una clave descartable local si se omite.
# FAKE_M1_PORT=3120
# El M1 falso y el Backend MSW se describen en docs/agents/real-m1-development.md.

# ─── Backend MSW local para real-m1 ─────────────────────
# Solo para probar desde un frontend local; el Backend de desarrollo real usa su origen publicado.
# M6_REAL_M1_MOCK_BACKEND=true
# M6_BACKEND_ORIGIN=http://m6-demo-backend.invalid

# ─── Sesión del BFF ─────────────────────────────────────
# Clave que sella la cookie m6_session. Obligatoria en producción.
# En producción, usar un valor aleatorio de 32 bytes o más (openssl rand -base64 32).
M6_SESSION_SECRET=local-dev-secret

# ─── MSW (solo desarrollo) ──────────────────────────────
# Setear a "true" para deshabilitar el service worker de mocks (p. ej. en e2e).
# NEXT_PUBLIC_DISABLE_MSW=
