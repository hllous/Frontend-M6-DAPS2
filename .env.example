# ─── Autenticación del BFF ──────────────────────────────
# mock                → sirve datos de fixtures locales (default en desarrollo).
# backend-development → reenvía cada petición al backend real (M6_BACKEND_ORIGIN)
#                       autenticando con M6_DEV_JWT.
# real-m1             → autenticación real de M1 (solo servidor; requiere M1_BASE_URL).
M6_AUTH_MODE=mock

# ─── Backend real (solo con M6_AUTH_MODE=backend-development) ──
# Origen del backend M6. En producción: la URL del backend desplegado.
# Si el backend local usa el puerto 3000, ejecutá Next.js en otro puerto
# (por ejemplo: pnpm dev --port 3001).
M6_BACKEND_ORIGIN=http://localhost:3000

# Firma local de demo (solo servidor, NUNCA con prefijo NEXT_PUBLIC_; sin valor real en el repositorio).
# M6_JWT_SECRET es el JWT_SECRET del backend, en base64. Con él, el BFF firma en cada petición un token HS256 de 5 minutos
# con la identidad de la persona del seed que eligió el perfil (iss, sub, sub_type, rol, typ: access, exp). La sesión
# vale 8 horas desde el login (sin corte por inactividad) y no depende del vencimiento del token.
# SOLO para la demo desplegada: nunca cargar este secreto en un ambiente con usuarios reales. Sale cuando M1 emita el login real (src/lib/demo-jwt.ts).
# M6_JWT_SECRET=
# M6_JWT_ISSUER=modulo1-ciudadanos

# Alternativa sin firma local (un solo token para todos los perfiles, vence a los 15 min salvo fecha límite):
# JWT firmado con el JWT_SECRET del backend (payload mínimo: { sub, exp }).
# M6_DEV_JWT=

# ─── M1 real o falso local ──────────────────────────────
# Base de M1. Para el M1 desplegado: https://ciudadanos-m1-backend.onrender.com/
# Para el M1 falso local: http://127.0.0.1:3120/api/v1/
# En producción debe ser HTTPS y apuntar al M1 real. Nunca habilitar el servidor falso.
# M1_BASE_URL=https://ciudadanos-m1-backend.onrender.com/
# M1_FAKE_ENABLED=true
# M1_FAKE_JWT_SECRET=  # Base64 opcional para el servidor falso; usa una clave descartable local si se omite.
# FAKE_M1_PORT=3120
# El M1 falso y el Backend MSW se describen en docs/agents/real-m1-development.md.

# ─── Backend MSW local para real-m1 ─────────────────────
# Solo para probar desde un frontend local; el Backend de desarrollo real usa su origen publicado.
# M6_REAL_M1_MOCK_BACKEND=true
# M6_BACKEND_ORIGIN=http://m6-demo-backend.invalid

# ─── Sesión del BFF ─────────────────────────────────────
# Clave que sella la cookie m6_session. Obligatoria en producción.
# En producción, usar un valor aleatorio de 32 bytes o más (openssl rand -base64 32).
M6_SESSION_SECRET=local-dev-secret

# ─── MSW (solo desarrollo) ──────────────────────────────
# Setear a "true" para deshabilitar el service worker de mocks (p. ej. en e2e).
# NEXT_PUBLIC_DISABLE_MSW=
